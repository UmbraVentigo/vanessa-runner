// BSLLS-off
// Тестовый набор: ibsrv (Run Enterprise / Test Xunit / Test Vanessa)
//
// Проверяет:
//   - наличие CLI-флагов --ibsrv, --ibsrv-direct, --ibsrv-debug, --ibsrv-log-data в подкомандах
//     run enterprise, test xunit, test vanessa.
//   - что флаг --ibsrv для серверной ИБ выдаёт предупреждение и не пытается
//     поднять автономный сервер (валидация "только для файловых ИБ").
//   - что флаг --ibsrv в сочетании с --no-wait выдаёт предупреждение и
//     отключает режим ibsrv (ibsrv не имеет смысла без ожидания).
//
// Аналог легаси-тестов:
//   ТестДолжен_ЗапуститьОбработкуЗакрытьПредприятиеIbsrv (legacy/tests/xunits/run.os)
//   ТестДолжен_ВыполнитьУспешноеТестированиеПроектаIbsrv (legacy/tests/xunits/xunit.os)
//   ТестДолжен_ВыполнитьФичуПаузаIbsrv                  (legacy/tests/xunits/vanessa.os)

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// ---------- Видимость опций в справке ----------

&Тест
Процедура ТестДолжен_ВывестиОпцииIbsrvВСправкеRunEnterprise() Экспорт

	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	Исполнитель.ДобавитьФлаг("--help");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "наличие ibsrv-опций в справке vrunner run enterprise");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-direct");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-debug");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-log-data");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиОпциюIbsrvВСправкеTestXunit() Экспорт

	Исполнитель = СоздатьИсполнителя("test", "xunit");
	Исполнитель.ДобавитьФлаг("--help");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "наличие ibsrv-опции в справке vrunner test xunit");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-direct");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-debug");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-log-data");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиОпциюIbsrvВСправкеTestVanessa() Экспорт

	Исполнитель = СоздатьИсполнителя("test", "vanessa");
	Исполнитель.ДобавитьФлаг("--help");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "наличие ibsrv-опции в справке vrunner test vanessa");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-direct");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-debug");
	Исполнитель.ОжидаемЧтоВыводСодержит("--ibsrv-log-data");

КонецПроцедуры

// ---------- Валидация: ibsrv применим только к файловой ИБ ----------

// Если строка подключения серверная (/S"server\base") - режим ibsrv
// игнорируется с предупреждением, и команда пробует обычный режим.
&Тест
&Тег("integration")
Процедура ТестДолжен_ОтклонитьIbsrvДляСервернойИБ() Экспорт

	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	// Серверная ИБ - ibsrv не должен запуститься
	Исполнитель.ДобавитьОпцию("--ibconnection", "/S""localhost\NoSuchBase""");
	Исполнитель.ДобавитьОпцию("--exitCodePath", ОбъединитьПути(Исполнитель.КаталогРаботы(), "exit.txt"));
	Исполнитель.ДобавитьФлаг("--ibsrv");

	Исполнитель.ВыполнитьКоманду();

	// Команда упадёт по другой причине (нет такой базы), но предупреждение должно быть в выводе.
	Исполнитель.ОжидаемЧтоВыводСодержит("Серверные ИБ не поддерживаются ibsrv");

КонецПроцедуры

// Если задан --no-wait вместе с --ibsrv - режим ibsrv игнорируется.
&Тест
&Тег("integration")
Процедура ТестДолжен_ОтклонитьIbsrvПриNoWait() Экспорт

	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьФлаг("--ibsrv");
	Исполнитель.ДобавитьФлаг("--no-wait");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоВыводСодержит("Запуск без ожидания не поддерживается при работе с ibsrv");

КонецПроцедуры

// ---------- Интеграционный тест запуска ibsrv ----------

// Аналог легаси ТестДолжен_ЗапуститьОбработкуЗакрытьПредприятиеIbsrv:
// поднимаем файловую ИБ, выполняем обработку ЗакрытьПредприятие.epf через ibsrv.
&Тест
&Тег("integration")
Процедура ТестДолжен_ВыполнитьОбработкуЧерезIbsrv() Экспорт

	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	ИнициализироватьПустуюИБ(КаталогБазы);

	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ПутьEpf = ПолучитьПутьКОбработкеЗакрытьПредприятие();

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--execute", ПутьEpf);
	Исполнитель.ДобавитьФлаг("--ibsrv");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск обработки через ibsrv");
	Исполнитель.ОжидаемЧтоВыводСодержит("Используется ibsrv");
	Исполнитель.ОжидаемЧтоВыводСодержит("Запущен ibsrv на основном порту");
	Исполнитель.ОжидаемЧтоВыводСодержит("Процесс ibsrv остановлен");

КонецПроцедуры

// Явно заданный СВОБОДНЫЙ порт - сервер стартует на нём, обработка выполняется.
&Тест
&Тег("integration")
Процедура ТестДолжен_ЗапуститьIbsrvНаСвободномПорту() Экспорт

	Порт = 8400;

	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	ИнициализироватьПустуюИБ(КаталогБазы);

	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	СтрокаПодключения = "/F""" + КаталогБазы + """";
	ПутьEpf = ПолучитьПутьКОбработкеЗакрытьПредприятие();

	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьОпцию("--execute", ПутьEpf);
	Исполнитель.ДобавитьФлаг("--ibsrv");
	Исполнитель.ДобавитьОпцию("--ibsrv-port", Формат(Порт, "ЧГ=0"));

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "запуск ibsrv на свободном порту " + Порт);
	Исполнитель.ОжидаемЧтоВыводСодержит("Запущен ibsrv на основном порту " + Порт);

КонецПроцедуры

// Явно заданный ЗАНЯТЫЙ порт - сервер не может забиндить порт и падает с внятной ошибкой.
// Это регрессионный тест бага детекта занятого порта (issue #707): ibsrv создаёт lock.pid
// ДО привязки http-порта, поэтому Запустить() возвращается успешно, хотя процесс затем падает.
&Тест
&Тег("integration")
Процедура ТестДолжен_УпастьСВнятнойОшибкой_ЕслиIbsrvПортЗанят() Экспорт

	Порт = 8401;

	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	ИнициализироватьПустуюИБ(КаталогБазы);

	// Занимаем порт сторонним TCP-сервером - ibsrv не сможет на нём подняться.
	БлокировщикПорта = Новый TCPСервер(Порт);
	БлокировщикПорта.Запустить();

	Попытка

		Исполнитель = СоздатьИсполнителя("run", "enterprise");
		СтрокаПодключения = "/F""" + КаталогБазы + """";
		ПутьEpf = ПолучитьПутьКОбработкеЗакрытьПредприятие();

		Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
		Исполнитель.ДобавитьОпцию("--execute", ПутьEpf);
		Исполнитель.ДобавитьФлаг("--ibsrv");
		Исполнитель.ДобавитьОпцию("--ibsrv-port", Формат(Порт, "ЧГ=0"));

		Исполнитель.ВыполнитьКоманду();

		// Тогда - ненулевой код возврата и внятное сообщение про занятый порт.
		Ожидаем.Что(Исполнитель.КодВозврата(), "ibsrv на занятом порту " + Порт + " должен упасть").Не_().Равно(0);
		Исполнитель.ОжидаемЧтоВыводСодержит("порт");
		Исполнитель.ОжидаемЧтоВыводСодержит(Формат(Порт, "ЧГ=0"));

	Исключение

		БлокировщикПорта.Остановить();
		ВызватьИсключение;

	КонецПопытки;

	БлокировщикПорта.Остановить();

КонецПроцедуры

// ---------- Сохранение журнала регистрации ----------

// Каталог ЖР сохраняется после выполнения команды и остановки настоящего ibsrv.
// Проверяется только наличие файла в заданном месте, без анализа записей журнала.
&Тест
&Тег("integration")
Процедура ТестДолжен_СохранитьЖурналIbsrvПоОпцииКоманднойСтроки() Экспорт

	// Дано - отдельная временная ИБ и относительный путь с пробелами и кириллицей
	Исполнитель = ПодготовитьЗапускДляПроверкиЖурнала();
	КаталогЖурнала = "Журнал регистрации";
	// ИсполнительCLI собирает строку запуска: кавычки для пробелов задаём явно.
	Исполнитель.ДобавитьОпцию("--ibsrv-log-data", """" + КаталогЖурнала + """");

	// Когда / Тогда - команда завершилась, файл ЖР остался в рабочем каталоге команды
	ВыполнитьКомандуИПроверитьЖурнал(Исполнитель, КаталогЖурнала);

КонецПроцедуры

&Тест
&Тег("integration")
Процедура ТестДолжен_СохранитьЖурналIbsrvПоПеременнойОкружения() Экспорт

	// Дано - каталог ЖР задан абсолютным путём через окружение процесса Runner
	Исполнитель = ПодготовитьЗапускДляПроверкиЖурнала();
	КаталогЖурнала = "Журнал регистрации";
	Исполнитель.УстановитьПеременнуюСреды("VRUNNER_IBSRV_LOG_DATA",
		ОбъединитьПути(Исполнитель.КаталогРаботы(), КаталогЖурнала));

	// Когда / Тогда
	ВыполнитьКомандуИПроверитьЖурнал(Исполнитель, КаталогЖурнала);

КонецПроцедуры

&Тест
&Тег("integration")
Процедура ТестДолжен_СохранитьЖурналIbsrvПоФайлуНастроек() Экспорт

	// Дано - каталог ЖР задан в разделе vrunner.run.enterprise файла настроек
	Исполнитель = ПодготовитьЗапускДляПроверкиЖурнала();
	КаталогЖурнала = "Журнал регистрации";
	ПутьНастроек = ОбъединитьПути(Исполнитель.КаталогРаботы(), "settings.json");
	Запись = Новый ЗаписьТекста(ПутьНастроек, КодировкаТекста.UTF8NoBOM);
	Запись.Записать("{ ""vrunner"": { ""run"": { ""enterprise"": { ""ibsrv-log-data"": ""Журнал регистрации"" } } } }");
	Запись.Закрыть();
	Исполнитель.ДобавитьОпцию("--settings", ПутьНастроек);

	// Когда / Тогда
	ВыполнитьКомандуИПроверитьЖурнал(Исполнитель, КаталогЖурнала);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Знач Группа, Знач Подкоманда)
	Аргументы = Новый Массив;
	Аргументы.Добавить(Группа);
	Аргументы.Добавить(Подкоманда);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

// Использует штатные helpers модуля: Runner создаёт ИБ и запускает обработку завершения.
Функция ПодготовитьЗапускДляПроверкиЖурнала()

	КаталогБазы = ВременныеФайлы.СоздатьКаталог();
	ИнициализироватьПустуюИБ(КаталогБазы);
	Исполнитель = СоздатьИсполнителя("run", "enterprise");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--execute", ПолучитьПутьКОбработкеЗакрытьПредприятие());
	Исполнитель.ДобавитьФлаг("--ibsrv");
	Возврат Исполнитель;

КонецФункции

Процедура ВыполнитьКомандуИПроверитьЖурнал(Исполнитель, Знач КаталогЖурнала)

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "сохранение журнала регистрации после запуска через ibsrv");
	Исполнитель.ОжидаемЧтоФайлСуществует(ОбъединитьПути(КаталогЖурнала, "1Cv8.lgf"));

КонецПроцедуры

// Создать пустую файловую ИБ через `vrunner infobase init`.
Процедура ИнициализироватьПустуюИБ(Знач КаталогБазы)

	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Исполнитель = Новый ИсполнительCLI(Аргументы);

	СтрокаПодключения = "/F""" + КаталогБазы + """";
	Исполнитель.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Исполнитель.ДобавитьФлаг("--ibcmd");

	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "инициализация пустой ИБ (подготовка теста)");

КонецПроцедуры

// Путь к собранной обработке ЗакрытьПредприятие.epf (поставляется в репозитории).
Функция ПолучитьПутьКОбработкеЗакрытьПредприятие()

	Корень = ТекущийКаталог();
	Путь = ОбъединитьПути(Корень, "epf");
	Путь = ОбъединитьПути(Путь, "ЗакрытьПредприятие.epf");

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Не найдена обработка ЗакрытьПредприятие.epf по пути: %1", Путь);
	КонецЕсли;
	Возврат Файл.ПолноеИмя;

КонецФункции

#КонецОбласти
